{
  "ssh": [
    {
      "regex": "SSH-\\d\\.\\d-OpenSSH_([\\w.]+)",
      "template": "OpenSSH {0}"
    },
    {
      "regex": "SSH-(\\d\\.\\d)-([\\w.]+)",
      "template": "{1} (protocol {0})"
    }
  ],
  "http": [
    {
      "regex": "Server:\\s*Apache/([\\d.]+)",
      "template": "Apache httpd {0}"
    },
    {
      "regex": "Server:\\s*nginx/([\\d.]+)",
      "template": "nginx {0}"
    },
    {
      "regex": "Server:\\s*Microsoft-IIS/([\\d.]+)",
      "template": "Microsoft IIS {0}"
    }
  ],
  "https": [
    {
      "regex": "Server:\\s*Apache/([\\d.]+)",
      "template": "Apache httpd {0}"
    },
    {
      "regex": "Server:\\s*nginx/([\\d.]+)",
      "template": "nginx {0}"
    }
  ],
  "ftp": [
    {
      "regex": "220.*vsFTPd ([\\d.]+)",
      "template": "vsFTPd {0}"
    },
    {
      "regex": "220.*ProFTPD ([\\d.]+)",
      "template": "ProFTPD {0}"
    }
  ],
  "smtp": [
    {
      "regex": "220.*Postfix",
      "template": "Postfix"
    },
    {
      "regex": "220.*Exim ([\\d.]+)",
      "template": "Exim {0}"
    }
  ],
  "mysql": [
    {
      "regex": "([\\d]+\\.[\\d]+\\.[\\d]+)-MariaDB",
      "template": "MariaDB {0}"
    },
    {
      "regex": "([\\d]+\\.[\\d]+\\.[\\d]+)",
      "template": "MySQL {0}"
    }
  ],
  "redis": [
    {
      "regex": "redis_version:([\\d.]+)",
      "template": "Redis {0}"
    }
  ]
}
